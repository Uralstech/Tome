<UserControl x:Class="Tome.TitleBar"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tome"
             Height="30">
    <Grid Background="#FFFFFFF5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0"
                   Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                   FontSize="12"
                   Margin="12,0,10,0"
                   VerticalAlignment="Center"/>

        <ContentPresenter Grid.Column="1"
                          Content="{Binding MenuContent, ElementName=Root}"
                          VerticalAlignment="Center"/>
        
        <Grid Grid.Column="2"/>

        <StackPanel Grid.Column="3" Orientation="Horizontal">
            <Button Content="–"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Padding="0,0,0,1.5"
                    Click="Minimize_Click"/>
            <Button Content="□"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Padding="0,0,0,4"
                    Click="Maximize_Click"/>
            <Button Content="x"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Padding="0,0,0,3"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
