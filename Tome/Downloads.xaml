<Window x:Class="Tome.Downloads"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tome"
        mc:Ignorable="d"
        WindowStyle="None"
        MinHeight="480" MinWidth="640"
        Height="480" Width="640" 
        Title="Tome: Mod Manager for Deadlock" Background="Beige">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="25"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <local:TitleBar DockPanel.Dock="Top"/>

        <Grid Margin="5,5,5,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="LogsTextBox" Grid.Row="0" IsReadOnly="True" Margin="0,0,0,1" />

            <Border x:Name="FileSelectionBorder" Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                    Background="LightYellow" Padding="5,2,5,5" Margin="0,0,0,1" Visibility="Collapsed">

                <StackPanel Grid.Row="0">
                    <TextBlock Text="'ABCD' has multiple files. Choose one to install:" FontSize="12" Margin="0,0,0,5"/>

                    <ItemsControl>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Name}" GroupName="FileSelectionGroup" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Install" HorizontalAlignment="Right" Padding="5,0,5,0" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Background="LightYellow" Padding="5,2,5,5" Visibility="Collapsed">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="CurrentDownloadText" FontSize="12" Margin="0,0,1,5"/>
                    <ProgressBar x:Name="DownloadProgressBar" Height="20"/>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2" Rows="1">
                <Button Content="Cancel" Margin="0,0,1,0"/>
                <Button Content="Continue"/>
            </UniformGrid>
        </Grid>
    </DockPanel>
</Window>
