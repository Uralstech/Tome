<Window x:Class="Tome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tome"
        xmlns:gamebanana="clr-namespace:GamebananaAPI.Data;assembly=GamebananaAPI"
        mc:Ignorable="d"
        WindowStyle="None"
        ContentRendered="Window_ContentRendered"
        Title="Tome: Mod Manager for Deadlock" Height="480" Width="640" Background="Beige">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="25"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <local:TitleBar DockPanel.Dock="Top">
            <local:TitleBar.MenuContent>
                <Menu
                  Background="Transparent"
                  WindowChrome.IsHitTestVisibleInChrome="True">

                    <MenuItem Header="_File">
                        <MenuItem Header="Update Game Path" Click="UpdateGamePath_Click"/>
                        <MenuItem Header="Launch Deadlock" Click="LaunchDeadlock_Click"/>
                        <Separator/>
                        <MenuItem Header="Default Filters" Loaded="MenuItem_Loaded">
                            <MenuItem Header="SFW Only" IsCheckable="True" Tag="{x:Static gamebanana:Visibility.Show}" Click="FilterChange_Click"/>
                            <MenuItem Header="SFW + Content Warnings" IsCheckable="True" Tag="{x:Static gamebanana:Visibility.Warn}" Click="FilterChange_Click"/>
                            <MenuItem Header="All Content (Including NSFW)" IsCheckable="True" Tag="{x:Static gamebanana:Visibility.Hide}" Click="FilterChange_Click"/>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="GitHub" Click="GitHub_Click"/>
                    </MenuItem>
                </Menu>
            </local:TitleBar.MenuContent>
        </local:TitleBar>
        
        <Grid Margin="5,5,5,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalAlignment="Top" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <TextBox TextWrapping="NoWrap" Text="Search for mods..." Grid.Column="0" Margin="0,0,1,0"
                         x:Name="SearchBox" KeyDown="Search_KeyDown"/>
                <Button Content="Search" Grid.Column="1" Margin="0,0,1,0" Click="Search_Click"/>
                <Button Content="Apply" Grid.Column="2"/>
            </Grid>

            <UniformGrid Grid.Row="1" Rows="1" VerticalAlignment="Top" Margin="0,0,0,5" >
                <ToggleButton Content="Installed" x:Name="InstalledButton" Checked="Category_Checked" Margin="0,0,1,0"/>
                <ToggleButton Content="Featured" x:Name="FeaturedButton" Checked="Category_Checked" Margin="0,0,1,0"/>
                <ToggleButton Content="Top Submissions" x:Name="TopSubmissionsButton" Checked="Category_Checked" Margin="0,0,0,0"/>
            </UniformGrid>

            <DataGrid x:Name="ModsGrid" Grid.Row="2"
                      Style="{StaticResource DataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      IsReadOnly="True">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Likes" Binding="{Binding Likes}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource EllipsisTextBlockStyle}"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource EllipsisTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="Installed" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Installed, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Update" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Update, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanUpdate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="5">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="?" Click="InfoButton_Click" Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
