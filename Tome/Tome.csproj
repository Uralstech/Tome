<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
	<ApplicationIcon>Icon.ico</ApplicationIcon>
	<Version>1.0.0-preview.2</Version>
	<AppBuildId>1</AppBuildId>
	  
	<Product>Tome</Product>
	<Copyright>Copyright 2026 URAV ADVANCED LEARNING SYSTEMS PRIVATE LIMITED</Copyright>
	<Authors>Udayshankar Ravikumar</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
    <PackageReference Include="ValveKeyValue" Version="0.80.0.542" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamebananaAPI\GamebananaAPI.csproj" />
  </ItemGroup>

  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)VersionInfo.g.cs" Lines="namespace Tome { internal static class VersionInfo { public const string Version = &quot;$(Version)&quot;%3B public const int BuildId = $(AppBuildId)%3B } }" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionInfo.g.cs" />
    </ItemGroup>
  </Target>
</Project>
