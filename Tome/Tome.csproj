<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
	<Version>1.0.0-preview.1</Version>
	<AppBuildId>0</AppBuildId>
	  
	<Product>Tome</Product>
	<Copyright>Copyright 2026 URAV ADVANCED LEARNING SYSTEMS PRIVATE LIMITED</Copyright>
	<Authors>Udayshankar Ravikumar</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="ValveKeyValue" Version="0.73.0.538" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamebananaAPI\GamebananaAPI.csproj" />
  </ItemGroup>

  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)VersionInfo.g.cs" Lines="namespace Tome { internal static class VersionInfo { public const string Version = &quot;$(Version)&quot;%3B public const int BuildId = $(AppBuildId)%3B } }" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionInfo.g.cs" />
    </ItemGroup>
  </Target>
</Project>
